# Copy this file to ".env" and fill it in, then restart with: npx expo start -c
#
# While testing on your phone with Expo Go, this must be a LAN address your phone can reach -
# "localhost" means the phone itself, not your computer. Find your computer's LAN IP:
#   Mac:     ipconfig getifaddr en0
#   Windows: ipconfig            (look for "IPv4 Address")
#   Linux:   hostname -I
# The deployed Vendly API on Render (the first request after it has been idle takes about a minute):
EXPO_PUBLIC_API_BASE_URL=https://vendly-api-kzcf.onrender.com

# Or, to test against a backend running on your own computer, use its LAN address instead:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:4000

EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
