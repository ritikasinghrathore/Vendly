# ---------- Copy to ".env" and fill in. NEVER commit ".env". ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL. The value below matches docker-compose.yml.
DATABASE_URL=postgres://vendly:vendly_dev_password@localhost:5432/vendly
DATABASE_SSL=false          # set to true for hosted databases that require SSL
DB_POOL_MAX=10

# Login tokens. Generate a long random secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_ISSUER=vendly-api
JWT_AUDIENCE=vendly-app
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Public address of this API (used to build image links). In production: https://api.yourdomain.com
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (leave empty: the mobile app does not need CORS).
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Render/Railway/Nginx = 1). Needed for correct rate limiting.
TRUST_PROXY=0

# ---------- Payments ----------
# "mock"     = safe local testing, no real money, no Razorpay account needed
# "razorpay" = Razorpay (use TEST keys first: rzp_test_...)
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-only-mock-webhook-secret

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=            # created once with:  npm run razorpay:create-plan

# Vendly Shopkeeper Pro price in paise (100000 = Rs 1,000).
PLAN_AMOUNT_PAISE=100000
# Extra days of access after a renewal is due (covers late webhooks and payment retries).
SUBSCRIPTION_GRACE_DAYS=3
# Free trial days when a shop is created (0 = no trial, payment is required straight away).
TRIAL_DAYS=0
# Run the background job that expires lapsed subscriptions.
RUN_JOBS=true
